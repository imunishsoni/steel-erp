#--------------------------------------------------------------------
# STEEL ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# For Indian Heavy-Steel Fabricator supplying Power, Sugar & Cement Plants
# Tech Stack: XAMPP, PHP 8.1+, CodeIgniter 4, MySQL, Bootstrap 5, jQuery
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
# For PHP Spark Serve: http://localhost:8080/
# For XAMPP Apache:    http://localhost/steel-erp/public/
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB via XAMPP or Homebrew)
# Import database/steel_erp.sql before starting
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = steel_erp
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# SESSION (Database Session Handler using ci_sessions table)
#--------------------------------------------------------------------

session.driver = CodeIgniter\Session\Handlers\DatabaseHandler
session.savePath = ci_sessions

#--------------------------------------------------------------------
# ENCRYPTION KEY
#--------------------------------------------------------------------

encryption.key = hex2bin:a9f8c2e4b7d1063f5e8a2c4b7d9f1e3a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5
